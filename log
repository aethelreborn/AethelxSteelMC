#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

LOG_DIR="./.logs"
PATTERN="${1:-}"

if [[ ! -d "$LOG_DIR" ]]; then
    echo "No log directory yet. Start the server first."
    exit 0
fi

LATEST_LOG="$(ls -t "$LOG_DIR"/*.log 2>/dev/null | head -1)"

if [[ -z "$LATEST_LOG" ]]; then
    echo "No log files found in $LOG_DIR"
    exit 0
fi

echo "▸ Tailing: $LATEST_LOG"
echo ""

if [[ -n "$PATTERN" ]]; then
    tail -f "$LATEST_LOG" | grep --line-buffered -i "$PATTERN"
else
    tail -f "$LATEST_LOG"
fi
