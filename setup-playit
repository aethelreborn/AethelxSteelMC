#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLAYIT_DIR="$SCRIPT_DIR/.playit"
STATE_DIR="$PLAYIT_DIR/state"
SOCKET_PATH="$STATE_DIR/agent.sock"
SECRET_PATH="$STATE_DIR/playit.toml"
AGENT_PATH="$PLAYIT_DIR/playit"
CLI_PATH="$PLAYIT_DIR/playit-cli"
LOG_PATH="$PLAYIT_DIR/agent.log"
CONFIG_PATH="${PLAYIT_CONFIG:-$SCRIPT_DIR/playit.conf}"

PLAYIT_NAME="AethelxStoneMC"
PLAYIT_PORT="25565"
PLAYIT_PROTOCOL="tcp"
if [[ -f "$CONFIG_PATH" ]]; then
    source "$CONFIG_PATH"
fi

case "$(uname -m)" in
    x86_64) AGENT_ASSET="playit-linux-amd64"; CLI_ASSET="playit-cli-linux-amd64" ;;
    aarch64|arm64) AGENT_ASSET="playit-linux-aarch64"; CLI_ASSET="playit-cli-linux-aarch64" ;;
    *) printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
esac

mkdir -p "$STATE_DIR"

download() {
    local asset="$1"
    local destination="$2"
    if [[ ! -x "$destination" ]]; then
        printf 'Downloading %s...\n' "$asset"
        curl -fL --retry 3 -o "$destination" \
            "https://github.com/playit-cloud/playit-agent/releases/latest/download/$asset"
        chmod +x "$destination"
    fi
}

download "$AGENT_ASSET" "$AGENT_PATH"
download "$CLI_ASSET" "$CLI_PATH"

if [[ ! -S "$SOCKET_PATH" ]]; then
    printf 'Starting the Playit agent...\n'
    nohup "$AGENT_PATH" \
        --socket-path "$SOCKET_PATH" \
        --secret-path "$SECRET_PATH" \
        >"$LOG_PATH" 2>&1 &
    agent_pid=$!
    printf '%s\n' "$agent_pid" > "$STATE_DIR/agent.pid"
    for _ in {1..30}; do
        [[ -S "$SOCKET_PATH" ]] && break
        sleep 1
    done
fi

if [[ ! -S "$SOCKET_PATH" ]]; then
    printf 'Playit did not create its IPC socket. See %s\n' "$LOG_PATH" >&2
    exit 1
fi

if [[ ! -f "$SECRET_PATH" ]]; then
    printf 'No Playit credentials found. Approve the browser link shown below.\n'
    "$CLI_PATH" --socket-path "$SOCKET_PATH" setup
fi

printf '\nPlayit agent: %s\nMinecraft target: %s %s\n\n' \
    "$PLAYIT_NAME" "$PLAYIT_PROTOCOL" "$PLAYIT_PORT"
"$CLI_PATH" --socket-path "$SOCKET_PATH" status
printf '\nAdd a %s tunnel to local port %s in the Playit dashboard if one is not already configured.\n' \
    "$PLAYIT_PROTOCOL" "$PLAYIT_PORT"